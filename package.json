{
  "name": "codetool",
  "displayName": "CodeTool 编码工具",
  "private": true,
  "version": "0.1.0",
  "description": "CodeTool - 浏览器编解码工具扩展（Base64/URL/Unicode/HTML实体/Hex/JWT/时间戳/Hash/进制转换）",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare",
    "build:prepare": "esno scripts/prepare.ts",
    "build:web": "vite build",
    "dev": "cross-env NODE_ENV=development run-s clear build:web build:prepare",
    "clear": "rimraf --glob extension/dist extension/manifest.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,vue,json,css,md} scripts/**/*.ts",
    "format:check": "prettier --check src/**/*.{ts,tsx,js,jsx,vue,json,css,md} scripts/**/*.ts"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "tailwindcss": "^4.1.16",
    "vue": "^3.5.22",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.0",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "chokidar": "^4.0.3",
    "cross-env": "^10.1.0",
    "esno": "^4.8.0",
    "fs-extra": "^11.3.2",
    "kolorist": "^1.8.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.2.0",
    "vite": "^7.1.12"
  }
}
